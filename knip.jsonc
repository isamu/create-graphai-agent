{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Analysis is scoped to the CLI tool's own source (src/**). The template/ directory is
  // NOT the tool's source — it holds files the CLI copies into scaffolded projects — so it
  // is deliberately outside both entry and project.
  // The CLI entry is src/index.ts (package.json "bin"/"main" point to its build output
  // lib/index.js), which knip auto-detects as a default entry, so it is not listed here
  // (listing it triggers a "redundant entry" hint). tests/*.ts are standalone node --test
  // scripts, so they are entry points too.
  "entry": ["tests/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "rules": {
    // Warn mode: every rule is "warn" (reported, exit 0) or "off". Nothing gates CI here.
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "unresolved": "off",
    "binaries": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}
